# Copiar a .env y completar con credenciales de una base de pruebas.
# En PostgreSQL local ambas conexiones pueden utilizar el mismo servidor.
DATABASE_URL="postgresql://skot_test:REEMPLAZAR@127.0.0.1:55432/skot_erp_test?schema=public"
DIRECT_URL="postgresql://skot_test:REEMPLAZAR@127.0.0.1:55432/skot_erp_test?schema=public"
JWT_SECRET="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO"
# Opcional: si se omite, se usa JWT_SECRET. Debe tener al menos 32 caracteres.
OFFLINE_SALE_SECRET="REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_DE_32_CARACTERES"

# Activar tras revisar los productos de venta y componentes de combos existentes.
REQUIRE_CLASSIFIED_CONSUMPTION="false"

# Simulación de balanza para pruebas sin hardware.
NEXT_PUBLIC_MOCK_SCALE="true"

# Opcional: cuenta Cloudinary de pruebas para cargar imágenes.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="skot-products"
